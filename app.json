{
  "expo": {
    "name": "Data Udipi App",
    "slug": "data-udipi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpeg",
    "splash": {
      "image": "./assets/images/frontpage_bg.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "scheme": "restaurantnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.jpeg"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.anonymous.dataudipiapp"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/frontpage_bg.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Data Udipi App to access your camera to scan table QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Data Udipi App to access your photos for profile pictures.",
          "cameraPermission": "Allow Data Udipi App to access your camera to take profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Data Udipi App to use your location to find nearby addresses."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "927f995e-93f1-4348-83d6-2b4a4753993c"
      }
    }
  }
}
