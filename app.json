{
  "expo": {
    "name": "Data Udipi",
    "slug": "data-udipi-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.jpeg",
    "scheme": "restaurantnative",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.jpeg",
      "infoPlist": {
        "UIBackgroundModes": [
          "voip"
        ],
        "NSMicrophoneUsageDescription": "Allow Data Udipi App to access your microphone for the voice assistant.",
        "NSCameraUsageDescription": "Allow Data Udipi App to access your camera to scan table QR codes."
      },
      "bundleIdentifier": "com.dataudipi.app"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION"
      ],
      "package": "com.dataudipi.app",
      "versionCode": 1
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#000000",
          "image": "./assets/images/frontpage_bg.png"
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Data Udipi to access your camera to scan table QR codes."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Data Udipi to access your photos for profile pictures.",
          "cameraPermission": "Allow Data Udipi to access your camera to take profile pictures."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Data Udipi to use your location to find nearby addresses."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true,
            "minSdkVersion": 24
          },
          "ios": {
            "deploymentTarget": "16.4"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "src/app"
      },
      "eas": {
        "projectId": "07a600e4-fe0d-4ba1-b941-36bed42fd455"
      }
    }
  }
}
